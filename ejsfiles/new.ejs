<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Chat</title>
    
  
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
   
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        
        <div class="form-header">
            <div class="icon-wrapper">
                <i class="fa-regular fa-paper-plane"></i>
            </div>
            <h2>New Message</h2>
            <p>Send a message to start a new conversation</p>
        </div>

        
        <form method="POST" action="/newaddchat">
            
           
            <div class="form-group">
                <label for="from">Sender Name</label>
                <div class="input-wrapper">
                    <input type="text" id="from" class="form-control" placeholder="Who are you?" name="from" required autocomplete="off">
                    <i class="fa-regular fa-user"></i>
                </div>
            </div>

           
            <div class="form-group">
                <label for="to">Receiver Name</label>
                <div class="input-wrapper">
                    <input type="text" id="to" class="form-control" placeholder="Received by..." name="to" required autocomplete="off">
                    <i class="fa-regular fa-circle-user"></i>
                </div>
            </div>

          
            <div class="form-group">
                <label for="msg">Message</label>
                <div class="input-wrapper textarea-wrapper">
                    <textarea id="msg" class="form-control" placeholder="Write your message here..." name="msg" required></textarea>
                    <i class="fa-regular fa-comment-dots"></i>
                </div>
            </div>

        
            <button type="submit" class="btn-submit">
                <span>Send Message</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

     
        <a href="/chats" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to All Chats
        </a>
    </div>

</body>
</html>